# Environment & Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL with PostGIS, fallback to SQLite for zero-friction local development)
DATABASE_URL=sqlite:///./agrisat.db
# For PostgreSQL: postgresql://agri_user:agri_pass@localhost:5432/agrisat_db

# Security & Authentication
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Kaggle Credentials (Recommended to place kaggle.json in ~/.kaggle/)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Storage Paths
DATASETS_DIR=./datasets
MODELS_DIR=./trained_models
REPORTS_DIR=./generated_reports

